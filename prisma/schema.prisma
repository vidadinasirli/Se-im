generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum RiskLevel {
  LOW
  HIGH
}

enum ChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QuestionStatus {
  DRAFT
  APPROVED
  REJECTED
}

enum ExamEventType {
  BURAXILIS
  BLOK
  QEBUL
  OTHER
}

enum SignalSource {
  GA4
  SEARCH_CONSOLE
  GOOGLE_TRENDS
  SITE_SEARCH
  CHAT_GAP
  CENTRAL_BANK
  DIM
}

enum OpportunityStatus {
  CANDIDATE
  PROCESSING
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  FAILED
}

enum AgentLogLevel {
  INFO
  WARNING
  ERROR
}

model ContentItem {
  id         String   @id @default(cuid())
  key        String   @unique
  value      Json
  sourceUrl  String
  confidence Float
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@index([updatedAt])
}

model PendingChange {
  id         String       @id @default(cuid())
  contentKey String
  oldValue   Json
  newValue   Json
  sourceUrl  String
  confidence Float
  riskLevel  RiskLevel
  status     ChangeStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  reviewedAt DateTime?

  @@index([status, createdAt])
  @@index([contentKey])
}

model JobLog {
  id        String   @id @default(cuid())
  jobName   String
  status    String
  message   String?
  createdAt DateTime @default(now())

  @@index([jobName, createdAt])
}

model ChangeLog {
  id         String   @id @default(cuid())
  contentKey String
  action     String
  oldValue   Json
  newValue   Json
  sourceUrl  String
  confidence Float
  createdAt  DateTime @default(now())

  @@index([contentKey, createdAt])
}

model Question {
  id           String         @id @default(cuid())
  groupSlug    String
  subject      String
  grade        Int
  topic        String
  difficulty   String
  prompt       String
  options      Json
  correctIndex Int
  explanation  String
  status       QuestionStatus @default(DRAFT)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([groupSlug, status])
  @@index([status, createdAt])
}

model ExamEvent {
  id                  String        @id
  title               String
  type                ExamEventType
  eventDate           DateTime?
  applicationDeadline DateTime?
  description         String?
  sourceUrl           String
  confidence          Float
  updatedAt           DateTime      @updatedAt
  createdAt           DateTime      @default(now())

  @@index([eventDate])
}

model ChatLog {
  id        String   @id @default(cuid())
  question  String
  answered  Boolean  @default(false)
  result    String   @default("PENDING")
  feedback  String?
  createdAt DateTime @default(now())

  @@index([answered, createdAt])
  @@index([feedback, createdAt])
}

model ChatRateLimit {
  id        String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

model ChatSearchDocument {
  id          String   @id
  title       String
  body        String
  url         String
  contentHash String
  updatedAt   DateTime @updatedAt

  @@index([updatedAt])
}

model Signal {
  id             String       @id @default(cuid())
  source         SignalSource
  topic          String
  rawValue       Json
  observedAt     DateTime     @default(now())
  score          Float        @default(0)
  opportunityId String?

  @@index([source, observedAt])
  @@index([topic, observedAt])
  @@index([opportunityId])
}

model Opportunity {
  id             String            @id @default(cuid())
  topicKey       String            @unique
  topic          String
  status         OpportunityStatus @default(CANDIDATE)
  score          Float             @default(0)
  sourceCount    Int               @default(0)
  decision       Json?
  reason         String?
  sourceUrls     Json
  pageSlug       String?
  firstSeenAt    DateTime          @default(now())
  lastSeenAt     DateTime          @default(now())
  processedAt    DateTime?
  processingStartedAt DateTime?

  @@index([status, score])
  @@index([lastSeenAt])
}

model AgentLog {
  id             String        @id @default(cuid())
  level          AgentLogLevel @default(INFO)
  stage          String
  message        String
  signalId       String?
  opportunityId  String?
  details        Json?
  createdAt      DateTime      @default(now())

  @@index([createdAt])
  @@index([stage, createdAt])
}

model PublishPolicy {
  id                 Int      @id @default(1)
  killSwitch         Boolean  @default(false)
  maxPagesPerDay     Int      @default(5)
  maxPagesPerHour    Int      @default(2)
  minimumConfidence  Float    @default(0.85)
  similarityLimit    Float    @default(0.7)
  minimumContentChars Int     @default(600)
  dailyTokenBudget   Int      @default(100000)
  tokensUsedToday    Int      @default(0)
  usageDate          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AgentPage {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  description    String
  content        String
  structuredData Json?
  sourceUrl      String
  riskLevel      String
  confidence     Float
  factCheckPassed Boolean @default(false)
  autoPublished  Boolean  @default(false)
  noindex        Boolean  @default(false)
  publishedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([publishedAt])
  @@index([noindex, publishedAt])
}

model AgentPageRevision {
  id          String   @id @default(cuid())
  pageSlug    String
  title       String
  description String
  content     String
  sourceUrl   String
  structuredData Json?
  riskLevel   String
  confidence  Float
  factCheckPassed Boolean
  version     Int
  createdAt   DateTime @default(now())

  @@unique([pageSlug, version])
  @@index([pageSlug, createdAt])
}

model AgentUsage {
  id         String   @id @default(cuid())
  requestKey String   @unique
  inputTokens Int     @default(0)
  outputTokens Int    @default(0)
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model AgentExecutionLock {
  id         Int      @id @default(1)
  lockedUntil DateTime?
  updatedAt  DateTime @updatedAt
}

model SiteSearchLog {
  id        String   @id @default(cuid())
  query     String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
